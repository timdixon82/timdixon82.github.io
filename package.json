{
  "name": "timdixon82-github-io",
  "version": "0.1.0",
  "description": "Tim Dixon's project-index landing page at projects.timdixon.net.",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:html": "html-validate index.html",
